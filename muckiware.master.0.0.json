                        "  (cd \"${ADMIN_ROOT}\"/Resources/app/administration && npm run convert-entity-schema)",
                        "fi",
                        "",
                        "npm run --prefix vendor/muckiware/master/Resources/app/administration/ dev",
                        ""
                    ],
                    "executable": true
